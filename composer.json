{
    "name": "yanlongli/php-apple-signin",
    "type": "library",
    "description": "Verify Sign In with Apple identity tokens (JWT) in PHP: Apple JWKS/RS256, audience/nonce validation and ES256 client_secret generation. 苹果登录/苹果登陆 PHP SDK。",
    "keywords": [
        "apple",
        "sign-in-with-apple",
        "apple-sign-in",
        "sign in with apple",
        "apple login",
        "apple-id",
        "php-apple-signin",
        "jwt",
        "jwk",
        "jwks",
        "json-web-token",
        "rs256",
        "es256",
        "identity-token",
        "id-token",
        "client-secret",
        "oidc",
        "oauth2",
        "authentication",
        "authorization",
        "ios",
        "laravel",
        "symfony",
        "苹果",
        "苹果登录",
        "苹果登陆",
        "苹果账号登陆"
    ],
    "license": "BSD-3-Clause",
    "homepage": "https://github.com/yanlong-li/php-apple-signin",
    "support": {
        "issues": "https://github.com/yanlong-li/php-apple-signin/issues",
        "source": "https://github.com/yanlong-li/php-apple-signin",
        "docs": "https://github.com/yanlong-li/php-apple-signin#readme"
    },
    "authors": [
        {
            "name": "Yanlongli",
            "email": "ahlyl94@gmail.com",
            "homepage": "https://github.com/yanlong-li",
            "role": "Developer"
        },
        {
            "name": "Griffin Ledingham",
            "email": "gcledingham@gmail.com",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": { "AppleSignIn\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "AppleSignIn\\Tests\\": "tests/" }
    },
    "require": {
        "php": "^8.0",
        "ext-json": "*",
        "ext-openssl": "*",
        "firebase/php-jwt": "^7.0",
        "guzzlehttp/guzzle": "^7.8 || ^8.0"
    },
    "replace": {
        "griffinledingham/php-apple-signin": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "scripts": {
        "test": "phpunit"
    },
    "suggest": {
        "psr/simple-cache": "Cache Apple public keys (^1.0 || ^2.0 || ^3.0) to avoid fetching them on every request."
    }
}
